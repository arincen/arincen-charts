{
    "name": "@arincen/charts",
    "version": "1.1.0",
    "description": "The charting library an AI agent can read. Lighter, faster, smarter: about 26 KB, zero dependencies. Two builds from one codebase, and toText/annotate so a model can read the chart and draw its answer back.",
    "license": "MIT",
    "author": "Arincen L.L.C-FZ",
    "homepage": "https://en.arincen.com/arincen-charts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/arincen/arincen-charts.git"
    },
    "bugs": {
        "url": "https://github.com/arincen/arincen-charts/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "chart",
        "charts",
        "canvas",
        "financial",
        "candlestick",
        "trading",
        "stock",
        "ai",
        "agent",
        "llm",
        "accessible"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/types/index.d.ts",
    "unpkg": "./dist/arincen-charts.standalone.js",
    "jsdelivr": "./dist/arincen-charts.standalone.js",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./full": {
            "types": "./dist/types/full.d.ts",
            "import": "./dist/full.mjs",
            "default": "./dist/full.mjs"
        },
        "./standalone": "./dist/arincen-charts.standalone.js",
        "./standalone/full": "./dist/arincen-charts-full.standalone.js",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "NOTICE"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "npm run build:bundles && npm run build:types",
        "build:bundles": "vite build --config vite.light.mjs && vite build --config vite.full.mjs && vite build --config vite.esm.mjs && ARINCEN_CHARTS_FULL=true vite build --config vite.esm.mjs",
        "build:types": "tsc -p tsconfig.json",
        "test": "node --test \"tests/*.test.js\"",
        "docs:dev": "npm --prefix docs run dev",
        "docs:build": "npm --prefix docs run build"
    },
    "devDependencies": {
        "typescript": "^5.4.5",
        "vite": "^5.0.0"
    }
}
